// 个人应用商店数据模型
// 说明：SQLite 不支持原生枚举，type / visibility / status 以字符串存储，
//       取值范围由 src/server/infra/constants.ts 统一约束。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 管理员账号，仅允许单账号使用
model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// 开发者账号，由管理员创建，可管理归属自己的应用
model Developer {
  id           String   @id @default(cuid())
  username     String   @unique
  displayName  String   @default("")
  passwordHash String
  /// ACTIVE | DISABLED
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  apps         App[]

  @@index([status])
}

/// 应用档案：Android 应用或网页作品
model App {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  summary       String
  description   String    @default("")
  /// ANDROID | WEB
  type          String
  category      String
  /// JSON 字符串数组
  tags          String    @default("[]")
  iconPath      String?
  /// JSON 路径数组
  screenshots   String    @default("[]")
  webUrl        String?
  packageName   String?   @unique
  /// 归属开发者，为空表示由管理员直接管理
  developerId   String?
  developer     Developer? @relation(fields: [developerId], references: [id], onDelete: SetNull)
  /// PUBLIC | PRIVATE
  visibility    String    @default("PUBLIC")
  pinned        Boolean   @default(false)
  downloadCount Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  releases      Release[]

  @@index([type, visibility])
  @@index([category])
  @@index([developerId])
}

/// Android 应用版本，一个应用同一时刻至多一条 isCurrent
model Release {
  id                     String    @id @default(cuid())
  appId                  String
  app                    App       @relation(fields: [appId], references: [id], onDelete: Cascade)
  versionName            String
  versionCode            Int
  changelog              String    @default("")
  filePath               String
  fileSize               Int
  sha256                 String
  signFingerprint        String?
  minSdk                 Int?
  forceUpdate            Boolean   @default(false)
  minSupportedVersionCode Int?
  /// 上传者标记：admin 或 dev:<username>
  uploadedBy             String?
  /// DRAFT | PUBLISHED | ARCHIVED
  status                 String    @default("DRAFT")
  isCurrent              Boolean   @default(false)
  downloadCount          Int       @default(0)
  publishedAt            DateTime?
  createdAt              DateTime  @default(now())

  @@unique([appId, versionCode])
  @@index([appId, status, isCurrent])
}

/// 管理后台操作审计日志
model AuditLog {
  id        String   @id @default(cuid())
  /// 操作者用户名
  actor     String
  /// 操作类型，如 app.create / release.publish
  action    String
  /// 操作对象，如应用名、版本号
  target    String   @default("")
  /// 补充说明
  detail    String   @default("")
  /// 来源 IP（反向代理场景记录完整转发链）
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// 站点运行配置（单行记录，id 固定为 1）
model SiteSetting {
  id        Int      @id @default(1)
  /// 前台与后台展示的站点名称
  siteName  String   @default("应用仓库")
  /// 单个 APK 上传上限（MB）
  maxApkMb  Int      @default(200)
  /// 站点兜底根地址（无请求上下文时使用）
  baseUrl   String   @default("")
  /// 开发者注册模式：OFF 关闭 | OPEN 开放注册 | INVITE 邀请码注册
  registrationMode String @default("OFF")
  updatedAt DateTime @updatedAt
}

/// 注册邀请码，单次使用，可设置有效期与备注
model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  /// 备注，便于区分批次或用途
  note      String    @default("")
  /// 创建者管理员用户名
  createdBy String    @default("")
  /// 过期时间，为空表示长期有效
  expiresAt DateTime?
  /// 使用时间，为空表示未使用
  usedAt    DateTime?
  /// 使用者用户名
  usedBy    String?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([usedAt])
}

/// 访问与安装分析事件，供管理员与开发者统计 PV/UV、下载与安装数据
model AnalyticsEvent {
  id          String   @id @default(cuid())
  /// page_view | download | install
  type        String
  /// 关联应用；首页等通用页面为空
  appId       String?
  /// 关联版本；页面浏览为空
  releaseId   String?
  /// 页面路径或来源页面
  path        String   @default("")
  /// 渠道标识，取自 ?from= 或 UTM 参数
  channel     String   @default("")
  /// 来源域名
  refererHost String   @default("")
  /// 客户端原始 IP，按需保留
  ip          String   @default("")
  /// IP 哈希，用于访客去重
  ipHash      String   @default("")
  /// 访客标识：IP + UA + 日期哈希
  visitorId   String   @default("")
  userAgent   String   @default("")
  /// 安装设备型号，客户端上报
  deviceModel String   @default("")
  /// 系统版本，客户端上报
  osVersion   String   @default("")
  /// install | update，仅安装事件
  installType String   @default("")
  versionCode Int?
  createdAt   DateTime @default(now())

  @@index([type, createdAt])
  @@index([appId, createdAt])
  @@index([visitorId, createdAt])
  @@index([createdAt])
}

