# 站点兜底基地址：页面展示与下载链接优先根据请求头自动推导，仅在无请求上下文时使用
# 使用 https:// 开头时会作为 Cookie Secure 与协议判断的兜底
BASE_URL=http://localhost:3000

# SQLite 数据库文件（相对 prisma/schema.prisma 所在目录解析）
DATABASE_URL="file:../data/appstore.db"

# 文件存储根目录（APK、图标、截图）
STORAGE_DIR=./storage

# 下载链接签名密钥（32 字节随机串，可用 openssl rand -hex 32 生成）
DOWNLOAD_SIGN_SECRET=change-me-to-a-32-byte-random-hex

# 统一会话签名密钥：管理员与开发者共用同一登录入口，身份由令牌角色区分
SESSION_SECRET=change-me-to-another-32-byte-random-hex

# 首位管理员（仅 npm run init-admin 时读取 ADMIN_PASSWORD，初始化后可删除该行）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# 单次上传 APK 大小上限（MB）：首次启动写入数据库，之后在「后台 → 设置」修改
MAX_APK_MB=200

# 站点名称：首次启动写入数据库，之后在「后台 → 设置」修改
NEXT_PUBLIC_SITE_NAME=应用仓库

# JSON 美化视图内部自请求地址（可选）：默认 http://127.0.0.1:${PORT:-3000}
# 反向代理到非 3000 端口或使用独立内部地址时再设置
# INTERNAL_ORIGIN=http://127.0.0.1:3000
